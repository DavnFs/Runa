# ==============================================================================
# Rona — Privacy-First Android .gitignore
# ==============================================================================
# IMPORTANT PRIVACY & SECURITY NOTE FOR DEVELOPERS:
# 1. .gitignore only prevents new/untracked files from being committed. It does
#    NOT remove files or secrets that were committed previously into Git history.
# 2. If any credential, signing key, token, or private database is accidentally
#    committed, it must be IMMEDIATELY REVOKED & ROTATED, not just deleted in Git.
# 3. NEVER commit real user health data, real menstrual logs, private notes,
#    or real partner credentials. Always use safe synthetic fixtures for tests.
# ==============================================================================

# ------------------------------------------------------------------------------
# Kotlin / Gradle / Build Artifacts
# ------------------------------------------------------------------------------
.gradle/
.kotlin/
build/
**/build/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
*.png
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ / IDEs
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/
local.properties

# ------------------------------------------------------------------------------
# Sensitive Signing Keys, Keystores & Certificate Bundles (CRITICAL)
# ------------------------------------------------------------------------------
*.jks
*.keystore
*.p12
*.pem
*.key
*.pk8
*.bks
keystore.properties
signing.properties
# CI-generated signing material (never committed; rotated per release)
app/keystore/

# ------------------------------------------------------------------------------
# Secrets, Tokens, API Keys & Environment Configs (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
secrets.xml
secrets.properties
google-services.json
figma_*.json
figma_*.png
*.token
*.secret
*.keyfile

# ------------------------------------------------------------------------------
# Local Databases, SQLCipher Dumps, Backups & Test Artifacts (CRITICAL)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlcipher
*.rona
*.ronabackup
*.runa-backup
/backups/
/local-data/
/dumps/
/scratch/
.tempmediaStorage/
temp/
tmp/

# ------------------------------------------------------------------------------
# AI Agents, Command Tools & System Generated Logs
# ------------------------------------------------------------------------------
.commandcode/
.system_generated/
.gemini/
*.log
docs/

# ------------------------------------------------------------------------------
# OS / Desktop Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Nn]onlinear/

# ------------------------------------------------------------------------------
# Whitelisted Preserved Files
# ------------------------------------------------------------------------------
# Safe environment templates (without actual secrets) are preserved
!.env.example
!.env.template
!.env.sample

# Room schema dumps are required for database migration validation tests
!app/schemas/

# Gradle wrapper binary
!gradle/wrapper/gradle-wrapper.jar
